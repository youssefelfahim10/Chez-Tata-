# Copier ce fichier en .env.local — ne jamais committer de valeurs réelles.

# URL du projet Supabase (région UE recommandée pour le RGPD).
NEXT_PUBLIC_SUPABASE_URL=
# Clé « publishable » (publique par conception ; la sécurité repose sur la RLS).
# Ne JAMAIS mettre ici la clé secrète / service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'application (liens de confirmation et d'invitation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Accès démo réservé à l'équipe (variables SERVEUR uniquement, jamais NEXT_PUBLIC_) ---
# Code à donner aux administrateurs (au moins 16 caractères aléatoires).
DEMO_ACCESS_CODE=
# Compte de démonstration (données fictives) utilisé après saisie du code.
DEMO_EMAIL=
DEMO_PASSWORD=
